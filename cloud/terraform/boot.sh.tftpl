#!/bin/bash
# FinePoint Perception server, first boot (docs/SERVER.md). Terraform renders this into the instance's user_data;
# every bash dollar-brace is doubled here. test_boot.sh runs it in a container with systemctl, aws and IMDS stubbed.
set -euo pipefail
exec > >(tee -a /var/log/perception-boot.log) 2>&1
echo "boot started $(date -u +%FT%TZ)"

CADDY_URL=https://github.com/caddyserver/caddy/releases/download/v2.11.9/caddy_2.11.9_linux_arm64.tar.gz
# from caddy_2.11.9_checksums.txt of the same release
CADDY_SHA512=9e5e76d7888542924de2c25353ae87c5f77e2a22c5b1198633cae13688922282e05383d142599205c88d8d80eee5e967d291214d7abce4835329a191b20dd6e0

install -d -m 0755 /etc/perception /etc/caddy /opt/perception /opt/perception/releases
cat > /etc/perception/boot.env <<'EOF'
BUCKET=${bucket}
REGION=${region}
DOMAIN=${domain}
EOF
. /etc/perception/boot.env

dnf install -y python3.12 python3.12-pip tar gzip shadow-utils util-linux dnf-automatic
id perception >/dev/null 2>&1 || useradd --system --home-dir /var/lib/perception --no-create-home --shell /sbin/nologin perception
id caddy >/dev/null 2>&1 || useradd --system --home-dir /var/lib/caddy --no-create-home --shell /sbin/nologin caddy
install -d -m 0700 -o perception -g perception /var/lib/perception
install -d -m 0700 -o caddy -g caddy /var/lib/caddy
[ -x /opt/perception/venv/bin/python ] || python3.12 -m venv /opt/perception/venv

tmp=$(mktemp -d)
curl -fsSL --retry 5 -o "$tmp/caddy.tar.gz" "$CADDY_URL"
echo "$CADDY_SHA512  $tmp/caddy.tar.gz" | sha512sum -c -
tar -xzf "$tmp/caddy.tar.gz" -C "$tmp" caddy
install -m 0755 "$tmp/caddy" /usr/local/bin/caddy
rm -rf "$tmp"

cat > /usr/local/bin/perception <<'EOF'
#!/bin/bash
# server.py <command> as the perception user, e.g. sudo perception add-user --email E --lab L --admin
set -euo pipefail
if [ "$(id -u)" = 0 ]; then exec runuser -u perception -- "$0" "$@"; fi
export PERCEPTION_CONFIG=$${PERCEPTION_CONFIG:-/etc/perception/config.json} PYTHONDONTWRITEBYTECODE=1
cd /var/lib/perception
exec /opt/perception/venv/bin/python /opt/perception/current/server.py "$@"
EOF

cat > /usr/local/bin/perception-update <<'EOF'
#!/bin/bash
# Installs the newest deploy/server.zip beside the running copy, switches to it, migrates and restarts.
set -euo pipefail
. /etc/perception/boot.env
umask 022
new=/opt/perception/releases/$(date -u +%Y%m%dT%H%M%SZ)
zip=$(mktemp --suffix=.zip)
# a new instance's role can take a few minutes to work
for i in $(seq 20); do
  aws s3 cp --only-show-errors --region "$REGION" "s3://$BUCKET/deploy/server.zip" "$zip" && break
  [ "$i" = 20 ] && { echo "could not fetch deploy/server.zip"; exit 1; }
  sleep 15
done
mkdir -p "$new"
python3.12 -m zipfile -e "$zip" "$new"
rm -f "$zip"
/opt/perception/venv/bin/pip install --quiet --disable-pip-version-check --require-hashes -r "$new/requirements.txt"
ln -sfn "$new" /opt/perception/current.new
mv -T /opt/perception/current.new /opt/perception/current
# the first boot restores before it migrates; afterwards the database always exists
if [ -f /var/lib/perception/perception.db ]; then
  /usr/local/bin/perception migrate
  systemctl restart perception.service
fi
ls -1d /opt/perception/releases/* | head -n -3 | while read -r old; do rm -rf "$old"; done
echo "installed $new"
EOF

cat > /usr/local/bin/perception-address <<'EOF'
#!/bin/bash
# Every boot: the public IPv4 can change after a stop and start, so config.json and the Caddyfile are rewritten.
set -euo pipefail
. /etc/perception/boot.env
imds=$${IMDS_ENDPOINT:-http://169.254.169.254}
token=$(curl -fsS --retry 10 --retry-connrefused -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' "$imds/latest/api/token")
ip=$(curl -fsS --retry 10 -H "X-aws-ec2-metadata-token: $token" "$imds/latest/meta-data/public-ipv4")
[[ $ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "no public IPv4: $ip"; exit 1; }
host=$${DOMAIN:-$ip}
umask 022
printf '{"bucket": "%s", "region": "%s", "public_url": "https://%s"}\n' "$BUCKET" "$REGION" "$host" > /etc/perception/config.json.new
mv /etc/perception/config.json.new /etc/perception/config.json
# Only 443 is open: certificates come by TLS-ALPN-01 there and nothing listens on 80. A client that connects to an IP
# sends no server name (Python's ssl never does), so default_sni picks the IP's certificate, which Let's Encrypt
# issues only under its shortlived profile.
if [ -n "$DOMAIN" ]; then
  cat > /etc/caddy/Caddyfile.new <<CADDY
{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

https://$host {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	reverse_proxy 127.0.0.1:8080
}
CADDY
else
  cat > /etc/caddy/Caddyfile.new <<CADDY
{
	admin off
	auto_https disable_redirects
	default_sni $host
	servers {
		protocols h1 h2
	}
}

https://$host {
	tls {
		issuer acme {
			profile shortlived
			disable_http_challenge
		}
	}
	reverse_proxy 127.0.0.1:8080
}
CADDY
fi
mv /etc/caddy/Caddyfile.new /etc/caddy/Caddyfile
echo "address $host"
EOF
chmod 0755 /usr/local/bin/perception /usr/local/bin/perception-update /usr/local/bin/perception-address

cat > /etc/systemd/system/perception-address.service <<'EOF'
[Unit]
Description=FinePoint Perception: write the address into config.json and the Caddyfile
Wants=network-online.target
After=network-online.target
Before=perception.service caddy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/perception-address

[Install]
WantedBy=multi-user.target
EOF

sandbox='NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
ReadWritePaths=/var/lib/perception
User=perception
Group=perception
WorkingDirectory=/var/lib/perception
Environment=PERCEPTION_CONFIG=/etc/perception/config.json PYTHONDONTWRITEBYTECODE=1'

cat > /etc/systemd/system/perception.service <<EOF
[Unit]
Description=FinePoint Perception server
Wants=network-online.target
After=network-online.target perception-address.service
Requires=perception-address.service

[Service]
ExecStart=/opt/perception/venv/bin/python /opt/perception/current/server.py serve --listen 127.0.0.1:8080
Restart=always
RestartSec=2
$sandbox

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/perception-backup.service <<EOF
[Unit]
Description=FinePoint Perception: copy the database to the bucket
After=network-online.target perception-address.service

[Service]
Type=oneshot
ExecStart=/opt/perception/venv/bin/python /opt/perception/current/server.py backup
$sandbox
EOF

cat > /etc/systemd/system/perception-backup.timer <<'EOF'
[Unit]
Description=FinePoint Perception: hourly database copy

[Timer]
OnCalendar=hourly
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
EOF

cat > /etc/systemd/system/caddy.service <<'EOF'
[Unit]
Description=Caddy: HTTPS in front of FinePoint Perception
Wants=network-online.target
After=network-online.target perception-address.service
Requires=perception-address.service

[Service]
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/caddy XDG_CONFIG_HOME=/var/lib/caddy
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/caddy
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF

sed -i -e 's/^upgrade_type *=.*/upgrade_type = security/' -e 's/^apply_updates *=.*/apply_updates = yes/' /etc/dnf/automatic.conf

systemctl daemon-reload
# login is SSH: the role allows Systems Manager nothing, so its agent would only retry
systemctl disable --now amazon-ssm-agent.service || true
systemctl enable perception-address.service
systemctl start perception-address.service
systemctl enable --now caddy.service dnf-automatic.timer
/usr/local/bin/perception-update

# A new database only when the bucket surely has no copy. A copy that cannot be restored leaves the server and its
# hourly copy off, so an empty database never replaces it, and the boot still finishes.
db=/var/lib/perception/perception.db
copies=0
if [ ! -f "$db" ]; then
  # --no-paginate: a paginated listing reports KeyCount as None, which read as "maybe a copy" on the first real boot
  copies=$(aws s3api list-objects-v2 --region "$REGION" --bucket "$BUCKET" --prefix backups/perception.db --no-paginate --query KeyCount --output text) || copies=unknown
  [ "$copies" = 0 ] || /usr/local/bin/perception restore || echo "restore failed"
fi
if [ -f "$db" ] || [ "$copies" = 0 ]; then
  /usr/local/bin/perception migrate
  systemctl enable --now perception.service perception-backup.timer
else
  echo "RESTORE FAILED: backups/perception.db may exist but was not restored, so the server and its hourly copy stay off."
  echo "Fix the cause, then: sudo perception restore && sudo perception migrate && sudo systemctl enable --now perception perception-backup.timer"
fi
echo "boot finished $(date -u +%FT%TZ)"
